{
  "name": "brainrot",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Brainrot Publishing House - Gen Z translations of classic literature",
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.15.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "echo 'Monorepo initialized. Run pnpm install to set up workspaces.'",
    "generate:formats": "tsx scripts/generate-formats.ts",
    "sync:blob": "tsx scripts/sync-translations.ts",
    "monitor": "tsx scripts/monitor-api-usage.ts",
    "monitor:dashboard": "open apps/web/public/monitoring/dashboard.html",
    "validate": "tsx scripts/validate-translations.ts",
    "validate:all": "tsx scripts/validate-translations.ts all --verbose"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cli-progress": "^3.11.6",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.5",
    "@vercel/blob": "^1.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axios": "^1.13.5",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.1.0",
    "ora": "^8.2.0",
    "p-limit": "^7.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phrazzld/brainrot.git"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "publishing",
    "books",
    "translations",
    "gen-z",
    "brainrot"
  ],
  "author": "Brainrot Publishing House",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "lodash.template": "npm:lodash@4.17.21",
      "playwright": "^1.56.1",
      "@playwright/test": "^1.56.1",
      "tar-fs": "^3.1.1",
      "tar-stream": "^3.1.7",
      "glob": "^11.1.0"
    }
  }
}

{
  "name": "@brainrot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "installConfig": {
    "pnpm": {
      "peerDependencyRules": {
        "allowedVersions": {
          "react": "19"
        }
      }
    }
  },
  "// NOTE": "This project requires --legacy-peer-deps to install due to React 19 compatibility issues with @testing-library/react",
  "// LEGACY_SCRIPTS": "Migration and utility scripts have been archived to /tools/legacy-scripts/ - see README.md there for documentation",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "test": "vitest",
    "lint": "next lint",
    "format": "npm run prettier:fix",
    "typecheck": "tsc --noEmit",
    "prettier:fix": "prettier --write .",
    "test:blob-urls": "vitest run blobUrlVerification.test.ts",
    "test:blob-urls:live": "VERIFY_LIVE_URLS=true vitest run blobUrlVerification.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@brainrot/blob-client": "workspace:*",
    "@brainrot/converter": "workspace:*",
    "@brainrot/metadata": "workspace:*",
    "@brainrot/types": "workspace:*",
    "@vercel/blob": "^1.0.0",
    "@wavesurfer/react": "^1.0.11",
    "cheerio": "^1.0.0",
    "dotenv": "^17.2.3",
    "gsap": "^3.12.5",
    "next": "^16.1.5",
    "openai": "^6.9.1",
    "pino": "^9.9.4",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wavesurfer.js": "^7.12.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.22",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.5",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.49",
    "prettier": "^3.7.4",
    "puppeteer": "^24.32.0",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "package.json": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=10"
    ]
  }
}

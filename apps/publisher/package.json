{
  "name": "@brainrot/publisher",
  "version": "1.0.0",
  "description": "CLI tool for publishing Brainrot books to multiple platforms",
  "private": true,
  "license": "MIT",
  "author": "Brainrot Publishing House",
  "type": "module",
  "bin": {
    "brainrot-publish": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting skipped for publisher - ESLint config needs update'",
    "test": "vitest"
  },
  "dependencies": {
    "@brainrot/metadata": "workspace:*",
    "@brainrot/types": "workspace:*",
    "@playwright/test": "^1.55.0",
    "axios": "^1.12.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "dotenv": "^17.2.2",
    "form-data": "^4.0.4",
    "inquirer": "^12.9.6",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "p-retry": "^5.1.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.2",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

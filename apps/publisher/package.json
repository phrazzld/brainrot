{
  "name": "@brainrot/publisher",
  "version": "1.0.0",
  "description": "CLI tool for publishing Brainrot books to multiple platforms",
  "private": true,
  "license": "MIT",
  "author": "Brainrot Publishing House",
  "type": "module",
  "bin": {
    "brainrot-publish": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting skipped for publisher - ESLint config needs update'",
    "test": "vitest"
  },
  "dependencies": {
    "@brainrot/metadata": "workspace:*",
    "@brainrot/types": "workspace:*",
    "@playwright/test": "^1.56.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "inquirer": "^12.9.4",
    "js-yaml": "^4.1.1",
    "ora": "^8.2.0",
    "p-retry": "^5.1.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.2",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
